---
---

<section id="contacto" class="py-24 bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 relative overflow-hidden">
	<!-- Efectos de fondo -->
	<div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] opacity-20"></div>
	<div class="absolute top-20 right-20 w-72 h-72 bg-purple-500/20 rounded-full blur-3xl"></div>
	<div class="absolute bottom-20 left-20 w-96 h-96 bg-pink-500/20 rounded-full blur-3xl"></div>
	
	<div class="max-w-7xl mx-auto px-8 relative z-10">
		<div class="text-center mb-16">
			<span class="text-purple-400 font-semibold text-sm uppercase tracking-wider mb-2 block">¿Hablamos?</span>
			<h2 class="text-4xl md:text-6xl font-extrabold text-white mb-4">
				Contáctame
			</h2>
			<p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto">
				¿Tienes un proyecto en mente? Trabajemos juntos para hacerlo realidad
			</p>
			<div class="w-24 h-1 bg-gradient-to-r from-purple-600 to-pink-600 mx-auto rounded-full mt-4"></div>
		</div>

		<div class="grid lg:grid-cols-[1fr_1.5fr] gap-12">
			<div class="flex flex-col gap-6 order-2 lg:order-1">
				<div class="group bg-slate-800/50 backdrop-blur-md border border-slate-700/50 rounded-2xl p-6 transition-all hover:bg-slate-800/80 hover:border-purple-500/50 hover:translate-x-2">
					<div class="text-4xl mb-3">📧</div>
					<h3 class="text-white text-xl font-bold mb-2 group-hover:text-purple-400 transition-colors">Email</h3>
					<a href="mailto:92eduardocastillo@gmail.com" class="text-slate-300 hover:text-purple-400 transition-colors font-medium">92eduardocastillo@gmail.com</a>
				</div>
				<div class="group bg-slate-800/50 backdrop-blur-md border border-slate-700/50 rounded-2xl p-6 transition-all hover:bg-slate-800/80 hover:border-purple-500/50 hover:translate-x-2">
					<div class="text-4xl mb-3">📱</div>
					<h3 class="text-white text-xl font-bold mb-2 group-hover:text-purple-400 transition-colors">Teléfono</h3>
					<a href="tel:+34644359767" class="text-slate-300 hover:text-purple-400 transition-colors font-medium">+34 644 359 767</a>
				</div>
				<div class="group bg-slate-800/50 backdrop-blur-md border border-slate-700/50 rounded-2xl p-6 transition-all hover:bg-slate-800/80 hover:border-purple-500/50 hover:translate-x-2">
					<div class="text-4xl mb-3">📍</div>
					<h3 class="text-white text-xl font-bold mb-2 group-hover:text-purple-400 transition-colors">Ubicación</h3>
					<p class="text-slate-300 font-medium">España</p>
				</div>
				<div class="flex gap-4 justify-center py-4">
					<a href="https://github.com" target="_blank" rel="noopener" class="w-14 h-14 bg-slate-800/50 backdrop-blur-md border border-slate-700/50 rounded-xl flex items-center justify-center text-slate-300 transition-all hover:bg-purple-600 hover:text-white hover:-translate-y-2 hover:border-purple-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>
					<a href="https://www.linkedin.com/in/eduardo-castillo-bello-838b92216" target="_blank" rel="noopener" class="w-14 h-14 bg-slate-800/50 backdrop-blur-md border border-slate-700/50 rounded-xl flex items-center justify-center text-slate-300 transition-all hover:bg-purple-600 hover:text-white hover:-translate-y-2 hover:border-purple-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
						</svg>
					</a>
				</div>
			</div>

			<form class="bg-slate-800/50 backdrop-blur-md border border-slate-700/50 rounded-2xl p-8 order-1 lg:order-2 hover:border-purple-500/50 transition-all" id="contact-form">
				<div class="mb-6">
					<label for="name" class="block text-white font-bold mb-2">Nombre</label>
					<input type="text" id="name" name="name" required placeholder="Tu nombre" class="w-full px-4 py-3 border-2 border-slate-600/50 rounded-xl bg-slate-900/50 text-white placeholder:text-slate-500 transition-all focus:outline-none focus:border-purple-500 focus:bg-slate-900/80">
				</div>
				<div class="mb-6">
					<label for="email" class="block text-white font-bold mb-2">Email</label>
					<input type="email" id="email" name="email" required placeholder="tu@email.com" class="w-full px-4 py-3 border-2 border-slate-600/50 rounded-xl bg-slate-900/50 text-white placeholder:text-slate-500 transition-all focus:outline-none focus:border-purple-500 focus:bg-slate-900/80">
				</div>
				<div class="mb-6">
					<label for="subject" class="block text-white font-bold mb-2">Asunto</label>
					<input type="text" id="subject" name="subject" required placeholder="¿En qué puedo ayudarte?" class="w-full px-4 py-3 border-2 border-slate-600/50 rounded-xl bg-slate-900/50 text-white placeholder:text-slate-500 transition-all focus:outline-none focus:border-purple-500 focus:bg-slate-900/80">
				</div>
				<div class="mb-6">
					<label for="message" class="block text-white font-bold mb-2">Mensaje</label>
					<textarea id="message" name="message" rows="5" required placeholder="Cuéntame sobre tu proyecto..." class="w-full px-4 py-3 border-2 border-slate-600/50 rounded-xl bg-slate-900/50 text-white placeholder:text-slate-500 transition-all focus:outline-none focus:border-purple-500 focus:bg-slate-900/80 resize-none"></textarea>
				</div>
				<button type="submit" class="group w-full px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-xl font-bold transition-all hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(168,85,247,0.5)] flex items-center justify-center gap-2">
					Enviar Mensaje
					<svg class="w-5 h-5 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<line x1="22" y1="2" x2="11" y2="13"></line>
						<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
					</svg>
				</button>
			</form>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		alert('¡Gracias por tu mensaje! Te contactaré pronto.');
		form.reset();
	});
</script>
