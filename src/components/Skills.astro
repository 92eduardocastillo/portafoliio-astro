---
const plcSkills = [
	{ name: 'Beckhoff Twincat', level: 90, icon: '🔧' },
	{ name: 'Siemens TIA Portal', level: 85, icon: '⚙️' },
	{ name: 'Schneider Unity Pro', level: 80, icon: '🔌' },
	{ name: 'Ladder Logic', level: 95, icon: '🪧' },
	{ name: 'SCADA/HMI', level: 85, icon: '📊' },
	{ name: 'Industrial Networks', level: 80, icon: '🌐' }
];

const webSkills = [
	{ name: 'HTML/CSS/Tailwind', level: 95, icon: '🎨' },
	{ name: 'Python/Flask/FastAPI', level: 82, icon: '🐍' },
	{ name: 'JavaScript/TypeScript', level: 90, icon: '🟨' },
	{ name: 'React/Astro/Next.js', level: 88, icon: '⚛️' },
	{ name: 'Node.js/Express', level: 85, icon: '🟢' },
	{ name: 'Git/GitHub', level: 90, icon: '🔀' }
];

const otherSkills = [
	{ name: 'Instrumentación', category: 'Industrial' },
	{ name: 'Variadores de Frecuencia', category: 'Industrial' },
	{ name: 'Redes Industriales', category: 'Industrial' },
	{ name: 'MQTT/OPC UA', category: 'Protocolos' },
	{ name: 'MySQL/PostgreSQL', category: 'Database' },
	{ name: 'Docker', category: 'DevOps' },
	{ name: 'RESTful APIs', category: 'Backend' },
	{ name: 'Responsive Design', category: 'Frontend' }
];
---

<section id="habilidades" class="py-24 bg-gradient-to-b from-slate-900 via-purple-900 to-slate-900 relative overflow-hidden">
	<!-- Fondo decorativo -->
	<div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f2e_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f2e_1px,transparent_1px)] bg-[size:14px_24px] opacity-20"></div>
	<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl animate-pulse"></div>
	<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-pink-500/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
	
	<div class="max-w-7xl mx-auto px-8 relative z-10">
		<!-- Header -->
		<div class="text-center mb-20">
			<span class="inline-block px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-sm font-bold rounded-full mb-4 shadow-lg">Tecnologías & Herramientas</span>
			<h2 class="text-5xl md:text-7xl font-extrabold text-white mb-6">
				Habilidades <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400">Técnicas</span>
			</h2>
			<p class="text-xl text-slate-300 max-w-3xl mx-auto">
				Dominio de herramientas industriales y tecnologías web modernas
			</p>
			<div class="w-32 h-1.5 bg-gradient-to-r from-purple-600 to-pink-600 mx-auto rounded-full mt-4"></div>
		</div>
		
		<!-- Skills Grid -->
		<div class="grid lg:grid-cols-2 gap-10 mb-16">
			<!-- PLC Skills -->
			<div class="group bg-slate-800/50 backdrop-blur-xl rounded-3xl p-8 border border-slate-700/50 hover:border-purple-500/50 transition-all hover:shadow-2xl hover:shadow-purple-500/20">
				<div class="mb-10">
					<div class="flex items-center gap-4 mb-3">
						<div class="w-16 h-16 bg-gradient-to-br from-amber-500 to-orange-600 rounded-2xl flex items-center justify-center text-3xl shadow-lg">
							⚙️
						</div>
						<div>
							<h3 class="text-3xl font-bold text-white">Programación PLC</h3>
							<p class="text-purple-300 font-medium">Automatización y Control Industrial</p>
						</div>
					</div>
				</div>
				<div class="space-y-6">
					{plcSkills.map(skill => (
						<div class="group/item">
							<div class="flex items-center justify-between mb-3">
								<div class="flex items-center gap-3">
									<span class="text-2xl">{skill.icon}</span>
									<span class="text-white font-bold text-lg group-hover/item:text-purple-400 transition-colors">{skill.name}</span>
								</div>
								<span class="text-amber-400 font-bold text-lg">{skill.level}%</span>
							</div>
							<div class="h-3 bg-slate-700/50 rounded-full overflow-hidden">
								<div class="h-full bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 rounded-full shadow-lg shadow-amber-500/50 animate-fill-bar relative overflow-hidden" style={`width: ${skill.level}%`}>
									<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent animate-shimmer"></div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- Web Skills -->
			<div class="group bg-slate-800/50 backdrop-blur-xl rounded-3xl p-8 border border-slate-700/50 hover:border-blue-500/50 transition-all hover:shadow-2xl hover:shadow-blue-500/20">
				<div class="mb-10">
					<div class="flex items-center gap-4 mb-3">
						<div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-2xl flex items-center justify-center text-3xl shadow-lg">
							🌐
						</div>
						<div>
							<h3 class="text-3xl font-bold text-white">Desarrollo Web</h3>
							<p class="text-blue-300 font-medium">Frontend & Backend</p>
						</div>
					</div>
				</div>
				<div class="space-y-6">
					{webSkills.map(skill => (
						<div class="group/item">
							<div class="flex items-center justify-between mb-3">
								<div class="flex items-center gap-3">
									<span class="text-2xl">{skill.icon}</span>
									<span class="text-white font-bold text-lg group-hover/item:text-blue-400 transition-colors">{skill.name}</span>
								</div>
								<span class="text-blue-400 font-bold text-lg">{skill.level}%</span>
							</div>
							<div class="h-3 bg-slate-700/50 rounded-full overflow-hidden">
								<div class="h-full bg-gradient-to-r from-blue-500 via-cyan-500 to-blue-600 rounded-full shadow-lg shadow-blue-500/50 animate-fill-bar relative overflow-hidden" style={`width: ${skill.level}%`}>
									<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent animate-shimmer"></div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>

		<!-- Otras Competencias -->
		<div class="bg-slate-800/50 backdrop-blur-xl rounded-3xl p-10 border border-slate-700/50">
			<h3 class="text-3xl font-bold text-white mb-8 text-center">Otras Competencias</h3>
			<div class="flex flex-wrap gap-4 justify-center">
				{otherSkills.map(skill => (
					<div class="group relative">
						<div class="bg-gradient-to-br from-slate-700/50 to-slate-800/50 border border-slate-600/50 text-white px-6 py-4 rounded-2xl font-bold transition-all hover:scale-110 hover:border-purple-500/50 hover:shadow-lg hover:shadow-purple-500/30 cursor-pointer">
							{skill.name}
						</div>
						<span class="absolute -top-2 -right-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white text-xs px-2 py-1 rounded-full font-bold opacity-0 group-hover:opacity-100 transition-opacity">
							{skill.category}
						</span>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes fillBar {
		from { width: 0; }
	}

	@keyframes shimmer {
		0% { transform: translateX(-100%); }
		100% { transform: translateX(100%); }
	}

	.animate-fill-bar {
		animation: fillBar 1.5s ease-out;
	}
	
	.animate-shimmer {
		animation: shimmer 2s infinite;
	}
</style>
