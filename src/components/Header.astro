---
---

<header class="fixed top-0 left-0 right-0 bg-slate-900/95 backdrop-blur-md z-1000 shadow-lg">
	<nav class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex justify-between items-center">
		<div class="text-2xl font-bold text-white">
			<span class="text-orange-500">&lt;</span>Portfolio<span class="text-orange-500">/&gt;</span>
		</div>
		<ul class="nav-links hidden md:flex list-none gap-8">
			<li><a href="#inicio" class="text-white font-medium hover:text-orange-500 transition-colors relative after:content-[''] after:absolute after:-bottom-1.25 after:left-0 after:w-0 after:h-0.5 after:bg-orange-500 after:transition-all hover:after:w-full">Inicio</a></li>
			<li><a href="#sobre-mi" class="text-white font-medium hover:text-orange-500 transition-colors relative after:content-[''] after:absolute after:-bottom-1.25 after:left-0 after:w-0 after:h-0.5 after:bg-orange-500 after:transition-all hover:after:w-full">Sobre Mí</a></li>
			<li><a href="#habilidades" class="text-white font-medium hover:text-orange-500 transition-colors relative after:content-[''] after:absolute after:-bottom-1.25 after:left-0 after:w-0 after:h-0.5 after:bg-orange-500 after:transition-all hover:after:w-full">Habilidades</a></li>
			<li><a href="#proyectos" class="text-white font-medium hover:text-orange-500 transition-colors relative after:content-[''] after:absolute after:-bottom-1.25 after:left-0 after:w-0 after:h-0.5 after:bg-orange-500 after:transition-all hover:after:w-full">Proyectos</a></li>
			<li><a href="#contacto" class="text-white font-medium hover:text-orange-500 transition-colors relative after:content-[''] after:absolute after:-bottom-1.25 after:left-0 after:w-0 after:h-0.5 after:bg-orange-500 after:transition-all hover:after:w-full">Contacto</a></li>
		</ul>
		<button class="mobile-menu md:hidden flex flex-col gap-1.25 bg-transparent border-0 cursor-pointer" id="mobile-menu">
			<span class="w-6 h-0.5 bg-white rounded transition-all"></span>
			<span class="w-6 h-0.5 bg-white rounded transition-all"></span>
			<span class="w-6 h-0.5 bg-white rounded transition-all"></span>
		</button>
	</nav>
	<ul class="nav-links-mobile md:hidden absolute top-full left-0 right-0 flex-col bg-slate-900/98 px-8 py-8 gap-4 -translate-y-full opacity-0 pointer-events-none transition-all list-none">
		<li><a href="#inicio" class="text-white font-medium hover:text-orange-500 transition-colors block">Inicio</a></li>
		<li><a href="#sobre-mi" class="text-white font-medium hover:text-orange-500 transition-colors block">Sobre Mí</a></li>
		<li><a href="#habilidades" class="text-white font-medium hover:text-orange-500 transition-colors block">Habilidades</a></li>
		<li><a href="#proyectos" class="text-white font-medium hover:text-orange-500 transition-colors block">Proyectos</a></li>
		<li><a href="#contacto" class="text-white font-medium hover:text-orange-500 transition-colors block">Contacto</a></li>
	</ul>
</header>

<script>
	const mobileMenu = document.getElementById('mobile-menu');
	const navLinksMobile = document.querySelector('.nav-links-mobile');

	mobileMenu?.addEventListener('click', () => {
		navLinksMobile?.classList.toggle('!translate-y-0');
		navLinksMobile?.classList.toggle('!opacity-100');
		navLinksMobile?.classList.toggle('!pointer-events-auto');
		navLinksMobile?.classList.toggle('!flex');
	});

	document.querySelectorAll('.nav-links-mobile a').forEach(link => {
		link.addEventListener('click', () => {
			navLinksMobile?.classList.remove('!translate-y-0', '!opacity-100', '!pointer-events-auto', '!flex');
		});
	});
</script>
