---
---

<section id="sobre-mi" class="py-24 bg-gradient-to-b from-white via-slate-50 to-white relative overflow-hidden">
  <!-- Decoración de fondo mejorada -->
  <div class="absolute top-20 right-10 w-96 h-96 bg-gradient-to-br from-purple-300 to-pink-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>
  <div class="absolute bottom-20 left-10 w-96 h-96 bg-gradient-to-br from-blue-300 to-cyan-300 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000"></div>
  <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gradient-to-br from-indigo-300 to-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>
  
  <div class="max-w-7xl mx-auto px-8 relative z-10">
    <div class="text-center mb-20">
      <span class="inline-block px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-sm font-bold rounded-full mb-4 shadow-lg">Conóceme Mejor</span>
      <h2 class="text-5xl md:text-7xl font-extrabold text-slate-900 mb-6">
        Sobre <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-600 via-pink-600 to-blue-600 animate-gradient">Mí</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto mb-4">
        Ingeniero apasionado por la tecnología y la innovación
      </p>
      <div class="w-32 h-1.5 bg-gradient-to-r from-purple-600 to-pink-600 mx-auto rounded-full"></div>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-16 items-start mb-20">
      <!-- Texto principal -->
      <div class="space-y-8">
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-slate-100 hover:shadow-2xl transition-all">
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center text-white text-2xl font-bold shadow-lg">1</div>
            <div>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Mi Visión</h3>
              <p class="text-lg text-slate-700 leading-relaxed">
                Soy un <span class="font-bold text-purple-600">Programador PLC y Desarrollador Web</span> con experiencia en automatización industrial y desarrollo de aplicaciones modernas. Trabajo para crear puentes entre el mundo industrial y el digital.
              </p>
            </div>
          </div>
        </div>
        
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-slate-100 hover:shadow-2xl transition-all">
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center text-white text-2xl font-bold shadow-lg">2</div>
            <div>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Mi Enfoque</h3>
              <p class="text-lg text-slate-700 leading-relaxed">
                Combino la <span class="font-bold text-blue-600">precisión de la ingeniería industrial</span> con la <span class="font-bold text-pink-600">creatividad del desarrollo web</span>, creando soluciones eficientes que optimizan procesos y mejoran la experiencia del usuario.
              </p>
            </div>
          </div>
        </div>
        
        <div class="bg-white rounded-3xl p-8 shadow-xl border border-slate-100 hover:shadow-2xl transition-all">
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-pink-500 to-rose-500 rounded-xl flex items-center justify-center text-white text-2xl font-bold shadow-lg">3</div>
            <div>
              <h3 class="text-2xl font-bold text-slate-900 mb-3">Mi Pasión</h3>
              <p class="text-lg text-slate-700 leading-relaxed">
                Me apasiona resolver problemas complejos y construir sistemas que marquen la diferencia, desde líneas de producción automatizadas hasta aplicaciones web escalables que impactan positivamente a las personas.
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Tarjetas de especialidades mejoradas -->
      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-6">
          <div class="group bg-gradient-to-br from-purple-500 to-purple-700 rounded-3xl p-6 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-3 hover:scale-105 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative z-10">
              <div class="text-5xl mb-4">⚙️</div>
              <h3 class="font-bold text-white text-xl mb-2">Automatización</h3>
              <p class="text-sm text-purple-100">Control industrial y sistemas PLC avanzados</p>
            </div>
          </div>
          
          <div class="group bg-gradient-to-br from-blue-500 to-blue-700 rounded-3xl p-6 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-3 hover:scale-105 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative z-10">
              <div class="text-5xl mb-4">💻</div>
              <h3 class="font-bold text-white text-xl mb-2">Desarrollo Web</h3>
              <p class="text-sm text-blue-100">Apps modernas, rápidas y escalables</p>
            </div>
          </div>
          
          <div class="group bg-gradient-to-br from-pink-500 to-rose-700 rounded-3xl p-6 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-3 hover:scale-105 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative z-10">
              <div class="text-5xl mb-4">📊</div>
              <h3 class="font-bold text-white text-xl mb-2">IoT Industrial</h3>
              <p class="text-sm text-pink-100">Integración y monitoreo en tiempo real</p>
            </div>
          </div>
          
          <div class="group bg-gradient-to-br from-cyan-500 to-cyan-700 rounded-3xl p-6 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-3 hover:scale-105 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative z-10">
              <div class="text-5xl mb-4">🎯</div>
              <h3 class="font-bold text-white text-xl mb-2">Soluciones</h3>
              <p class="text-sm text-cyan-100">Personalizadas y centradas en resultados</p>
            </div>
          </div>
        </div>
        
        <!-- Valores -->
        <div class="bg-gradient-to-br from-slate-900 to-purple-900 rounded-3xl p-8 shadow-2xl">
          <h3 class="text-2xl font-bold text-white mb-6 text-center">Mis Valores</h3>
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full"></div>
              <span class="text-white font-medium">Innovación constante</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 bg-gradient-to-r from-blue-400 to-cyan-400 rounded-full"></div>
              <span class="text-white font-medium">Código limpio y mantenible</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 bg-gradient-to-r from-pink-400 to-rose-400 rounded-full"></div>
              <span class="text-white font-medium">Aprendizaje continuo</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 bg-gradient-to-r from-cyan-400 to-blue-400 rounded-full"></div>
              <span class="text-white font-medium">Orientación a resultados</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(20px, -20px) scale(1.1); }
    50% { transform: translate(-20px, 20px) scale(0.9); }
    75% { transform: translate(20px, 20px) scale(1.05); }
  }
  
  @keyframes gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  
  .animate-gradient {
    background-size: 200% 200%;
    animation: gradient 3s ease infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
</style>